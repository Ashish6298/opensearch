# ==============================================================================
# OpenSearch Web — Docker Build Exclusions (.dockerignore) (Phase 119)
# ==============================================================================

# Version Control
.git
.github
.gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled artifacts (rebuilt deterministically inside container)
dist/
build/
*.tsbuildinfo

# Test and verification reports
coverage/
.nyc_output/
report/
docs/verification/

# Local state & persistent indexes (mounted via volumes)
data/
tmp/
.cache/

# Local environment and secret files
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# IDE, OS, and scratch files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log
