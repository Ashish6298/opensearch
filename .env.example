# ==============================================================================
# OpenSearch Root Environment Configuration Template
# Copy this file to .env for local development overrides.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

NODE_ENV=development
APP_NAME=opensearch
APP_VERSION=1.0.0

# API Configuration
API_PORT=3000
API_HOST=localhost

# Web Frontend Configuration
WEB_PORT=5173
WEB_HOST=localhost

# Data & Storage Paths (Relative to repository root)
STORAGE_DIR=./data/storage
INDEX_DIR=./data/index
CRAWLER_DATA_DIR=./data/crawler

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
