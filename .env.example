# ==============================================================================
# OpenSearch Root Environment Configuration Template (V1.0.0)
# Copy this file to .env for local development or set these variables in your
# free hosting platform (Render, Fly.io, Railway, Hugging Face Spaces, Koyeb, etc.)
# ==============================================================================

# Core Runtime Environment
NODE_ENV=development
APP_NAME=opensearch
APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# API Service Coordinates
# ------------------------------------------------------------------------------
API_PORT=3000
API_HOST=localhost
# In production on free PaaS, PORT and HOST are automatically injected.
# When NODE_ENV=production, API_HOST defaults to 0.0.0.0 and PORT is respected.
# CORS_ORIGIN: Restrict frontend origin in production (defaults to '*' if omitted)
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
BODY_LIMIT_BYTES=65536

# ------------------------------------------------------------------------------
# Web Frontend Service Coordinates
# ------------------------------------------------------------------------------
WEB_PORT=5173
WEB_HOST=localhost
# Public Search API URL consumed by the web browser interface
VITE_API_URL=http://localhost:3000/api/v1/search

# ------------------------------------------------------------------------------
# Storage & Data Directories (Relative or Absolute paths)
# ------------------------------------------------------------------------------
STORAGE_DIR=./data/storage
INDEX_DIR=./data/index
CRAWLER_DATA_DIR=./data/crawler

# ------------------------------------------------------------------------------
# Logging & Telemetry (Privacy-Compliant)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# Crawler Efficiency & Resource Controls (Phase 29 Free-Tier Safeguards)
# ------------------------------------------------------------------------------
CRAWLER_MAX_CONCURRENCY=1
CRAWLER_MAX_PAGES=1000
CRAWLER_MAX_DEPTH=3
CRAWLER_TIMEOUT_MS=10000
CRAWLER_MAX_PAGE_BYTES=2097152
CRAWLER_POLITENESS_DELAY_MS=1000
CRAWLER_RETRY_BUDGET=50
CRAWLER_CHECKPOINT_INTERVAL_PAGES=10
CRAWLER_USER_AGENT=OpenSearchBot/1.0 (+https://github.com/Ashish6298/opensearch)
