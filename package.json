{
  "name": "opensearch",
  "version": "1.0.0",
  "private": true,
  "description": "OpenSearch — A public, general-purpose, privacy-first search engine built from scratch.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -b && npm --workspace=@opensearch/web run build:assets",
    "start": "npm run start:api",
    "start:api": "npm --workspace=@opensearch/api run start",
    "start:web": "npm --workspace=@opensearch/web run start",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:vercel": "vercel --prod",
    "clean": "node ./scripts/clean.mjs",
    "verify:phase1": "node ./scripts/verify-phase1.mjs",
    "verify:phase2": "node ./scripts/verify-phase2.mjs",
    "verify:phase3": "node ./scripts/verify-phase3.mjs",
    "verify:phase4": "node ./scripts/verify-phase4.mjs",
    "verify:phase5": "node ./scripts/verify-phase5.mjs",
    "verify:phase6": "node ./scripts/verify-phase6.mjs",
    "verify:phase7": "node ./scripts/verify-phase7.mjs",
    "verify:phase8": "node ./scripts/verify-phase8.mjs",
    "verify:phase9": "node ./scripts/verify-phase9.mjs",
    "verify:phase10": "node ./scripts/verify-phase10.mjs",
    "verify:phase11": "node ./scripts/verify-phase11.mjs",
    "verify:phase12": "node ./scripts/verify-phase12.mjs",
    "verify:phase13": "node ./scripts/verify-phase13.mjs",
    "verify:phase14": "node ./scripts/verify-phase14.mjs",
    "verify:phase15": "node ./scripts/verify-phase15.mjs",
    "verify:phase16": "node ./scripts/verify-phase16.mjs",
    "verify:phase17": "node ./scripts/verify-phase17.mjs",
    "verify:phase18": "node ./scripts/verify-phase18.mjs",
    "verify:phase19": "node ./scripts/verify-phase19.mjs",
    "verify:phase20": "node ./scripts/verify-phase20.mjs",
    "verify:phase21": "node ./scripts/verify-phase21.mjs",
    "verify:phase22": "node ./scripts/verify-phase22.mjs",
    "verify:phase23": "node ./scripts/verify-phase23.mjs",
    "verify:phase24": "node ./scripts/verify-phase24.mjs",
    "verify:phase25": "node ./scripts/verify-phase25.mjs",
    "verify:phase26": "node ./scripts/verify-phase26.mjs",
    "verify:phase27": "node ./scripts/verify-phase27.mjs",
    "verify:phase28": "node ./scripts/verify-phase28.mjs",
    "verify:phase29": "node ./scripts/verify-phase29.mjs",
    "verify:phase30": "node ./scripts/verify-phase30.mjs",
    "verify:phase31": "node ./scripts/verify-phase31.mjs",
    "verify:phase32": "node ./scripts/verify-phase32.mjs",
    "verify:phase33": "node ./scripts/verify-phase33.mjs",
    "verify:phase34": "node ./scripts/verify-phase34.mjs",
    "deploy:production": "node ./scripts/deploy-production.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
