{
  "name": "@opensearch/web",
  "version": "1.0.0",
  "private": true,
  "description": "Public Search Web Application for OpenSearch",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b && node -e \"fs.cpSync('src/style.css', 'dist/style.css'); fs.cpSync('src/app.js', 'dist/app.js');\"",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@opensearch/shared": "*"
  }
}
